{
  "manifest_version": 3,
  "name": "OBS Remote: YouTube to OBS",
  "description": "Sends the YouTube video playing in this browser to OBS through OBS Remote on this computer.",
  "version": "1.0.0",
  "key": "",
  "icons": { "128": "icon.png" },
  "action": { "default_title": "YouTube to OBS", "default_popup": "popup.html", "default_icon": { "128": "icon.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "minimum_chrome_version": "116"
}
