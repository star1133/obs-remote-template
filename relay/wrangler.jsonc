{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obs-remote",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Your own domain (optional, the domain must be on your Cloudflare account):
  // "routes": [{ "pattern": "obs.example.com", "custom_domain": true }],
  // Optional: "vars": { "INSTALLER_URL": "https://github.com/you/your-repo/releases/latest/download/OBS-Remote-Setup.exe" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Exact file paths only: index.html is served at /app by the Worker, not redirected to "/".
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // Per-IP brakes on the two public endpoints that create work: new rooms and pairing guesses.
  "ratelimits": [
    { "name": "REG_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "PAIR_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // SQLite-backed Durable Objects are available on the Workers Free plan
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
  // Optional: `wrangler secret put REGISTRATION_KEY` so only OBS instances that know
  // the key can create rooms on this relay (leave unset for an open public service).
}
